@book{BartelheimStauble2009WirtschaftlichenGrundlagen,
	address = {Rahden/Westf.},
	series = {Forschungen zur {Archäometrie} und {Altertumswissenschaft}},
	title = {Die wirtschaftlichen {Grundlagen} der {Bronzezeit} {Europas}. {The} {Economic} {Foundations} of the {European} {Bronze} {Age}},
	isbn = {9783896468741 (Pp.)},
	abstract = {Der Band geht auf die Sitzung der AG Bronzezeit bei der Tagung des Nordwestdeutschen Verbandes für Altertumswissenschaften 2004 in Hannover zurück, die um Beiträge namhafter Autoren zu ihren jeweiligen Forschungsregionen bereichert wurde. Er macht deutlich, daß entgegen früherer Vermutungen nicht nur die Produktion landwirtschaftlicher Güter und die Herstellung von Bronze die Wirtschaft der Bronzezeit bestimmten. Vielmehr zeigt sich heute für einen Großteil Europas vom Atlantik bis zu den Karpaten und von Skandinavien bis nach Süditalien eine merkliche regionale Diversifizierung der ökonomischen Strategien. Diese waren jeweils durch die lokalen natürlichen Gegebenheiten bestimmt und auf die Gewinnung spezifischer lokaler Ressourcen ausgerichtet, z.B. Holz, Bernstein und Flachs bei den organischen Rohstoffen und Salz, Steine und Metalle bei den anorganischen, denen in elf Beiträgen unter anderem nachgegangen wird. Hinzu kommen drei Regionalstudien aus Mitteleuropa, in denen spezielle Fragen der dortigen Ressourcennutzung vor dem Hintergrund des lokalen Siedlungsbildes behandelt werden.},
	number = {4},
	publisher = {Leidorf},
	editor = {Bartelheim, Martin and Stäuble, Harald},
	year = {2009},
	keywords = {Bronzezeit, \#Projekt\_Hsdlg\_FbzMbz, \#Projekt\_EneoFbzMbz, Wirtschaft, AG Bronzezeit},
}

